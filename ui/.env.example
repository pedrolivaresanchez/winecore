# Título de la ventana
VITE_APP_TITLE=WineCore

# Puerto del servidor de desarrollo de Vite
VITE_APP_PORT=5173

# "true" activa el acceso de Timbal. En local se deja en false.
VITE_AUTH_ENABLED=false

# Vacío: el navegador llama a /api y el proxy de Vite reenvía a localhost:3000 sin el prefijo.
VITE_API_BASE_URL=

# Acceso de Timbal. Sin secretos: solo nombres.
VITE_TIMBAL_BASE_URL=https://api.timbal.ai
VITE_TIMBAL_ORG_ID=
VITE_TIMBAL_PROJECT_ID=
VITE_AUTH_TIMBAL_IAM=
